drift  = 0.4    % known per-step drift
x_init = 0.0    % known initial state, excluded from the trajectory
n      = 120    % trajectory length

sigma_step ~ normalize(truncate(Cauchy(0, 1), interval(0, inf)))

prior = lawof(record(sigma_step = sigma_step))

% One step of the walk: the state enters the mean, the drift is fixed.
step_kernel = prev -> Normal(prev + drift, sigma_step)

x ~ markovchain(step_kernel, x_init, n)

###
The reference engine cannot yet score this posterior: its CLM lowering of the
likelihood does not recognise the trajectory positions a `markovchain` density
threads from its own observed value, and refuses the body as not self-contained.
The likelihood itself scores exactly — `logdensityof(x, x_data)` with a fixed
`sigma_step` matches the closed form to 2e-13 over the whole relevant range of
`sigma_step`, and the posterior it implies has mean 0.8383 and sd 0.0546.
###
forward_kernel = kernelof(record(x = x), sigma_step = sigma_step)
L = likelihoodof(forward_kernel, record(x = x_data))
posterior = bayesupdate(L, prior)
